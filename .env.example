# ---------------------------------------------------------------------------
# Root example env. Copy the relevant blocks into apps/api/.env and
# apps/web/.env (each app reads its own). Documented here in one place so a
# new contributor sees the whole surface at a glance.
#
#   cp .env.example apps/api/.env
#   cp apps/web/.env.example apps/web/.env
# ---------------------------------------------------------------------------

# === apps/api ===

# Where the API listens. 4000 keeps it clear of the Vite dev server (5173).
PORT=4000

# "development" | "production" | "test". Controls logging, error verbosity,
# and whether Mongoose auto-builds indexes.
NODE_ENV=development

# MongoDB connection string. Defaults to the local mongod you already run.
# In production use your MongoDB Atlas SRV string.
MONGODB_URI=mongodb://localhost:27017/healthcare

# Comma-separated list of browser origins allowed to call the API (CORS).
# The Vite dev server origin in development; your Vercel URL in production.
CORS_ORIGIN=http://localhost:5173

# JWT signing secrets. MUST be long random strings and MUST differ from each
# other. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string

# Token lifetimes (vercel/ms format). Short access token, longer refresh.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Credentials for the seeded admin account (see apps/api/src/db/seed.js).
SEED_ADMIN_EMAIL=admin@healthcare.test
SEED_ADMIN_PASSWORD=Admin123!


# === apps/web (these belong in apps/web/.env, prefixed VITE_) ===

# Base URL of the API. In dev the Vite proxy forwards /api -> :4000, so the
# default relative value works locally with zero config.
VITE_API_BASE_URL=/api/v1
