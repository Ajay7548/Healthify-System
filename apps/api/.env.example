# Copy to apps/api/.env and fill in. See the repo-root .env.example for the
# full annotated list. Defaults here target the local mongod on :27017.

PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/healthcare
CORS_ORIGIN=http://localhost:5173

# Generate each with: openssl rand -base64 48  (they MUST differ)
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

SEED_ADMIN_EMAIL=admin@healthcare.test
SEED_ADMIN_PASSWORD=Admin123!
