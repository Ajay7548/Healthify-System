{
  "name": "@hc/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Healthcare dashboard REST API — Express 5 + Mongoose. The only backend.",
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.js",
    "start": "node src/server.js",
