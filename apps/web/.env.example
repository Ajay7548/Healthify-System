# Copy to apps/web/.env. Only VITE_-prefixed vars reach the browser bundle, so
# never put secrets here — Vite inlines these values into the built JavaScript.

# Dev default: the relative path the Vite proxy forwards to the API. In
# production set the full deployed API URL, e.g.
#   VITE_API_BASE_URL=https://hc-api.onrender.com/api/v1
VITE_API_BASE_URL=/api/v1
